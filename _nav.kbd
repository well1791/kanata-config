;; ==============================================================
;; Navigation module
;; Included by config.kbd via (include _nav.kbd).
;; ==============================================================
;; Contains:
;;   - chord aliases : na_up na_dn na_lt na_rt na_tab na_bspc
;;   - chord group   : defchords CH_NA
;;   - layers        : L_NAV_R, L_NAV_L
;;
;; Resolved via kanata global namespace:
;;   needs var     : chord_timeout (defvar in config.kbd)
;;   needs aliases : sw_al
;;   provides      : layer names L_NAV_R / L_NAV_L

(defalias
  ;; SWITCH TO
  sw_nav_r    (layer-switch L_NAV_R)
  sw_nav_l    (layer-switch L_NAV_L)

  ;; TAP
  na_pgup     (tap-hold $tap_timeout $hold_timeout pgup lmet)
  na_pgdn     (tap-hold $tap_timeout $hold_timeout pgdn lsft)
  na_entr     (tap-hold $tap_timeout $hold_timeout enter lsft)

  ;; CHORDS
  na_nav_lt  (chord CH_NA ch_lt)
  na_nav_rt  (chord CH_NA ch_rt)

  ;; NAVIGATION (up right left down enter bspc tab etc)
  na_nav_ti  (chord CH_NA ch_tab)
  na_nav_tm  (chord CH_NA ch_up)
  na_nav_tr  (chord CH_NA ch_bspc)
  na_nav_tp  @sw_al
  na_nav_si  (macro C-z)
  na_nav_hm  (chord CH_NA ch_dn)
  na_nav_hp  @na_entr
  na_nav_bi  pgup
  na_nav_bm  pgdn

  ;; MOVEMENT + MODIFIERS
  na_mov_ti  @na_pgup
  na_mov_tm  tab
  na_mov_tr  lalt
  na_mov_tp  @sw_al
  na_mov_si  XX
  na_mov_hi  @na_pgdn
  na_mov_hm  esc
  na_mov_hr  lctl
  na_mov_hp  @sw_al
  na_mov_bi  (macro C-v)
  na_mov_bm  (macro C-c)
)

(defchords CH_NA $chord_timeout
  (ch_tab) tab   (ch_up) up     (ch_bspc) bspc
  (ch_lt) left   (ch_dn) down   (ch_rt) rght

  ;;                  | | | | |     --     | | | | |
  ;;                  | |*|*|*|     --     |*|*|*| |
  (ch_lt ch_dn ch_rt) spc

  ;;                  | |*|*|*|     --     |*|*|*| |
  ;;                  | | | | |     --     | | | | |
  (ch_tab ch_up ch_bspc) esc

  ;;                  | |*| |*|     --     |*| |*| |
  ;;                  | | | | |     --     | | | | |
  (ch_tab ch_bspc) home

  ;;                  | | | | |     --     | | | | |
  ;;                  | |*| |*|     --     |*| |*| |
  (ch_lt ch_rt) end

  ;;                  | |*|*| |     --     | |*|*| |
  ;;                  | | | | |     --     | | | | |
  (ch_up  ch_bspc) del

  ;;                  | | |*|*|     --     |*|*| | |
  ;;                  | | | | |     --     | | | | |
  ;;(ch_tab  ch_up) ???

  ;;                  | |*| | |     --     | | |*| |
  ;;                  | | |*| |     --     | |*| | |
  ;;(ch_dn  ch_bspc) ???
)

;; Layer: Navigation layer with modifiers and chords
(deflayermap (L_NAV_R)
  ;; LEFT
                  q @sw_nav_l     w @na_mov_tr    e @na_mov_tm    r @na_mov_ti
                  a @na_mov_hp    s @na_mov_hr    d @na_mov_hm    f @na_mov_hi    g @na_mov_si
                                                  c @na_mov_bm    v @na_mov_bi

  ;; RIGHT
                  u @na_nav_ti    i @na_nav_tm    o @na_nav_tr    p @na_nav_tp
  h @na_nav_si    j @na_nav_lt    k @na_nav_hm    l @na_nav_rt    ; @na_nav_hp
                  m @na_nav_bi    , @na_nav_bm
)

;; Layer: The reverse of RIGHT
(deflayermap (L_NAV_L)
  ;; LEFT
                  q @na_nav_tp    w @na_nav_tr    e @na_nav_tm    r @na_nav_ti
                  a @na_nav_hp    s @na_nav_lt    d @na_nav_hm    f @na_nav_rt    g @na_nav_si
                                                  c @na_nav_bm    v @na_nav_bi

  ;; RIGHTqmk compile -kb beekeeb/3w6hs -km well1791-11k
                  u @na_mov_ti    i @na_mov_tm    o @na_mov_tr    p @sw_nav_r
  h @na_mov_si    j @na_mov_hi    k @na_mov_hm    l @na_mov_hr    ; @na_mov_hp
                  m @na_mov_bi    , @na_mov_bm
)

