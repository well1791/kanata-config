;; ==============================================================
;; Media layer module
;; Included by config.kbd via (include _media.kbd).
;; ==============================================================
;; Contains:
;;   - layer : L_MEDIA (volume, brightness, playback)
;;
;; Resolved via kanata global namespace:
;;   provides      : layer name L_MEDIA (triggered by os_media in config.kbd)

(defalias
  me_ti       mute
  me_tm       volu
  me_tr       prev
  me_tp       brup
  me_si       (cmd sh -c "systemctl --user restart kanata.service")
  me_hi       pp
  me_hm       voldwn
  me_hr       next
  me_hp       brdwn
  me_bi       XX
  me_bm       XX
)

(deflayermap (L_MEDIA) ;;
  ;; LEFT
          q @me_tp    w @me_tr    e @me_tm    r @me_ti
          a @me_hp    s @me_hr    d @me_hm    f @me_hi    g @me_si
                                  c @me_bm    v @me_bi

  ;; RIGHT
              u @me_ti    i @me_tm    o @me_tr    p @me_tp
  h @me_si    j @me_hi    k @me_hm    l @me_hr    ; @me_hp
              m @me_bi    , @me_bm
)
