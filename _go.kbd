;; ==============================================================
;; Go-to shortcuts layer module
;; Included by config.kbd via (include _go.kbd).
;; ==============================================================
;; Contains:
;;   - layer : L_GO (browser/app tab, history, window shortcuts)
;;
;; Resolved via kanata global namespace:
;;   provides      : layer name L_GO (triggered by os_go in config.kbd)

(defalias
  go_ti          (macro C-S-t)
  go_tm          (macro C-pgup)
  go_tr          (macro A-grv)
  go_tp          (macro A-1)
  go_si          (macro M-A-i)
  go_hi          (macro C-w)
  go_hm          (macro C-pgdn)
  go_hr          (macro C-tab)
  go_hp          (macro A-9)
  go_bi          XX
  go_bm          XX
)

(deflayermap (L_GO) ;; Go-to shortcuts
  ;; LEFT
          q @go_tp    w @go_tr    e @go_tm    r @go_ti
          a @go_hp    s @go_hr    d @go_hm    f @go_hi    g @go_si
                                  c @go_bm    v @go_bi

  ;; RIGHT
              u @go_ti    i @go_tm    o @go_tr    p @go_tp
  h @go_si    j @go_hi    k @go_hm    l @go_hr    ; @go_hp
              m @go_bi    , @go_bm
)
